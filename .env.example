# =============================================================================
# Alpha Trading Bot - 配置模板
# =============================================================================
# 使用说明:
#   1. 复制此文件为 .env
#   2. 填入你的API密钥等信息
#   3. 无需的项目可留空或删除
# =============================================================================

# =============================================================================
# 交易所配置 (OKX)
# =============================================================================
OKX_API_KEY=                                             # OKX API Key
OKX_SECRET=                                              # OKX Secret
OKX_PASSWORD=                                            # OKX Password
OKX_SYMBOL=BTC/USDT:USDT                                 # 交易对符号 (如 BTC/USDT:USDT, ETH/USDT:USDT)
OKX_LEVERAGE=10                                          # 杠杆倍数 (如 10 = 10倍杠杆)

# =============================================================================
# 交易周期配置
# =============================================================================
# 说明: 机器人按设定周期自动执行交易逻辑
CYCLE_MINUTES=15                                         # 交易周期(分钟) (如 15 = 每15分钟执行一次)
RANDOM_OFFSET_RANGE=180                                  # 随机偏移范围(秒) (如 180 = ±3分钟随机偏移，避免风控检测)
ORDER_CONFIRM_TIMEOUT_SECONDS=5                          # 市价单成交确认超时
ORDER_CONFIRM_POLL_INTERVAL_SECONDS=0.25                 # 成交状态轮询间隔

# =============================================================================
# AI配置 - 单AI模式 (推荐新手使用)
# =============================================================================
# 说明: 使用单个AI提供商进行分析，配置简单，响应快速
AI_MODE=single                                           # AI模式选择: single=单AI, fusion=多AI融合 (2026-11 建议 fusion: 单AI 保守易漏底)
AI_DEFAULT_PROVIDER=qwen38                               # 单AI模式下的AI提供商 (可选: qwen38/deepseek/kimi/openai/qwen/gemini/minimax)
                                                        # qwen38 = 自建 Qwen3.8-27B (ninfer, OpenAI 兼容), 默认替代 deepseek

# =============================================================================
# AI配置 - 多AI融合模式 (推荐进阶用户使用)
# =============================================================================
# 说明: 同时调用多个AI，综合分析结果，提高信号可靠性
# 融合策略说明:
#   - consensus (共识): 所有AI都给出相同信号才执行，风险最低
#   - weighted (加权平均): 根据权重计算各信号得分，得分最高者胜出
#   - majority (多数表决): 超过阈值比例的信号作为最终结果
#   - confidence (置信度): buy/sell信号优先于hold，需达到阈值

AI_FUSION_PROVIDERS=qwen38,kimi                          # 参与融合的AI提供商列表 (逗号分隔)
                                                        # 示例: qwen38,kimi,openai
                                                        # 可选: qwen38/deepseek/kimi/openai/qwen/gemini/minimax

AI_FUSION_STRATEGY=weighted                              # 融合策略 (consensus/weighted/majority/confidence)
                                                        # 推荐: weighted (加权平均，综合考虑各AI意见)

AI_FUSION_WEIGHTS=qwen38:0.5,kimi:0.5                    # 各提供商权重 (格式: 提供商:权重,提供商:权重; 未列提供商默认 1.0)
                                                        # 权重范围: 0.0-1.0，所有权重之和建议等于1
                                                        # 示例: qwen38:0.6,kimi:0.4 表示qwen38权重60%，kimi权重40%

AI_FUSION_THRESHOLD=0.6                                  # 融合阈值 (范围: 0.0-1.0)
                                                         # 含义: 达到此比例的信号才会被执行
                                                         # 示例: 0.6 表示60%以上的AI同意才执行
                                                         # 注意: consensus模式此参数无效
AI_BLOCK_DEGRADED_BUY=true                               # 降级reasoning信号BUY阻断开关(true=降级BUY→HOLD; kill-switch设false关闭)
                                                         # 说明: 当AI响应content为空、信号只能从reasoning_content提取时视为"降级",
                                                         #       若降级信号终态为BUY则降为HOLD, 避免低质量信号开多

# =============================================================================
# AI API Keys (各提供商独立配置)
# =============================================================================
# 说明: 填入对应AI提供商的API Key，留空则使用默认配置
# 获取地址:
#   - DeepSeek: https://platform.deepseek.com
#   - Kimi: https://platform.moonshot.cn
#   - OpenAI: https://platform.openai.com
#   - Qwen: https://dashscope.console.aliyun.com
#   - Gemini: https://ai.google.dev/gemini-api/docs/api-key
#   - Qwen3.8-27B (qwen38): 自建 ninfer 服务 (https://test-qwen38-27b.xxfcloud.com 反向代理), 需真实 key
DEEPSEEK_API_KEY=                                        # DeepSeek API Key
KIMI_API_KEY=                                            # Kimi API Key
OPENAI_API_KEY=                                          # OpenAI API Key
QWEN_API_KEY=                                            # Qwen API Key
GEMINI_API_KEY=                                          # Gemini API Key (或使用 GOOGLE_API_KEY)
GOOGLE_API_KEY=                                          # Gemini 兼容环境变量，优先级高于 GEMINI_API_KEY
MINIMAX_API_KEY=                                         # MiniMax API Key（可选）
QWEN38_API_KEY=sk-anything                               # 自建 Qwen3.8-27B (ninfer) API Key，不校验，占位即可

# ---- Jev 快车道 (TypeSafe System One 模型) ----
AI_FAST_LANE=off                                         # Jev快车道模式: off=关闭(默认) / shadow=只观察不采用 / on=启用
TYPESAFE_API_KEY=                                        # TypeSafe API Key (Jev)，AI_FAST_LANE != off 时必填
TYPESAFE_MODEL=jev-1.13.0                                # Jev 模型版本（建议 pin 固定版本）
TYPESAFE_BASE_URL=https://api.typesafe.ai                # TypeSafe API 基础地址
JEV_TIMEOUT=5.0                                          # 快车道请求超时(秒)，超时升级LLM
JEV_CONF_BUY=0.75                                        # BUY 采用的最低置信度
JEV_CONF_SELL=0.75                                       # SELL/SHORT 采用的最低置信度
JEV_CONF_HOLD=0.50                                       # HOLD 采用的最低置信度（安全默认动作，可更低）
JEV_RISK_NOUL_GATE=0.70                                  # 反转风险Noul超过此值强制升级LLM
JEV_CB_FAILURES=3                                        # 连续瞬态失败N次后打开熔断
JEV_CB_COOLDOWN=600                                      # 瞬态故障熔断冷却(秒)
JEV_CB_AUTH_COOLDOWN=21600                               # 欠费/鉴权失败熔断冷却(秒, 6h)

# =============================================================================
# 止损配置
# =============================================================================
# 说明: 止损比例用于控制单笔交易的最大亏损
# 计算方式: 止损价 = 入仓价 × (1 - 止损比例)

STOP_LOSS_PERCENT=0.005                                  # 亏损时止损比例 (范围: 0.001-0.1)
                                                        # 示例: 0.005 = 0.5% (入仓价10000，止损价9950)
                                                        # 说明: 价格下跌时触发，保护本金

STOP_LOSS_PROFIT_PERCENT=0.002                           # 盈利时止损比例 (范围: 0.001-0.1)
                                                        # 示例: 0.002 = 0.2% (入仓价10000，止损价9980)
                                                        # 说明: 价格上涨后触发，锁定部分利润
MIN_PROFIT_TO_TIGHTEN_STOP_PERCENT=0.001                 # 浮盈达到此比例后收紧止损保护利润
MIN_NET_PROFIT_TO_CLOSE_PERCENT=0                        # 浮盈低于此比例时不更新追踪止损，0=不启用
                                                        # 示例: 0.003 = 0.3% (>2倍OKX taker费)，避免被手续费以下"虚假浮盈"扫出
                                                        # 说明: 默认0表示关闭，建议实盘前先用测试模式验证后启用

TAKE_PROFIT_PERCENT=0.06                                 # 止盈比例 (范围: 0.01-0.5)
TAKE_PROFIT_MIN_NOTIONAL=0                               # 启用止盈单的最小名义金额(USDT)，低于此值只挂止损
                                                         # 2026-09-20 修复: notional 已按 ctVal 正确计算 (BTC-USDT-SWAP 1张=0.01 BTC)，
                                                         # 0.01 张实际名义 ≈ $7.5，旧值 50 基于 100× 高估的旧计算
TAKE_PROFIT_MIN_RR_RATIO=1.0                             # 止盈距离/止损距离下限(0=关闭)。默认1.0保证挂单R/R≥1, 防止TP距离<SL距离导致结构性亏损
                                                         # 示例: 1.5 = 要求止盈距离至少为止损距离的1.5倍
TAKE_PROFIT_MAX_ATR_MULTIPLIER=4.0                        # 止盈外扩的波动率上限: 外扩后TP距离不超过 k×ATR (0=关闭cap, 恢复单向外扩)。
                                                         # 低波动市把外扩目标收回到可达位置, 避免TP被拉到6×ATR导致利润无法兑现。默认4.0
STOP_LOSS_TOLERANCE_PERCENT=0.001                        # 止损价容错比例 (范围: 0.0-0.01)

# --- 2026-09-20 亏损结构修复新增配置 (日志证据驱动) ---
TAKE_PROFIT_FULL_AMOUNT_PULL_RATIO=1.0                   # 全仓止盈回退时的目标拉近比例 (0,1]，1.0=保持原目标(默认)。
                                                         # 旧行为固定 0.5 把止盈距离砍半，最小张数仓位 100% 走该分支，
                                                         # 30天日志 57/57 笔 TP 被压缩 → R/R 倒挂(盈亏比 0.62)。
TAKER_FEE_RATE=0.0005                                    # 单边 taker 手续费率 (OKX VIP0=0.0005)。
                                                         # 追踪止损仅在"锁定净浮盈≥2×往返手续费"后才收紧，
                                                         # 避免 0.1~0.3% 的手续费级"虚假盈利"被提前落袋。
SHORT_ENTRY_MAX_DAILY_CHANGE=1.5                         # 逆势做空门禁: 24h 涨幅(%)超过该值时禁止新开空单 (0=关闭)。
                                                         # 2026-09-18 在 +5.22% 大阳线日逆势做空单笔 -1.02%。
ALLOW_SHORT_SELLING=true                                 # 是否允许做空 (true/false)

# =============================================================================
# 系统配置
# =============================================================================
LOG_LEVEL=INFO                                           # 日志级别 (DEBUG/INFO/WARNING/ERROR)
                                                        # DEBUG: 详细调试信息
                                                        # INFO: 一般运行信息 (推荐)
                                                        # WARNING: 警告信息
                                                        # ERROR: 错误信息

# =============================================================================
# 运行模式配置
# =============================================================================
TEST_MODE=true                                           # 运行模式: true=测试模式, false=实盘模式
                                                        # 测试模式: 获取真实行情，执行策略逻辑，但不下单
                                                        # 实盘模式: 获取真实行情，执行真实交易（下单）
                                                        # 推荐: 先用测试模式验证逻辑，确认无误后再改为实盘模式
REAL_TRADING_CONFIRMED=false                             # 实盘二次确认开关（实盘时必须为true）
RUNTIME_ENVIRONMENT=dev                                  # 运行环境: dev/test/staging/prod（实盘仅允许prod/production）
# TRADING_STATE_DIR=                                     # 可选：交易状态目录；测试会自动隔离
                                                         # (2026-11-26: 不要写成 "TRADING_STATE_DIR= # 注释" 格式,
                                                         #  python-dotenv 会把注释文本当变量值 → 状态文件写入
                                                         #  "# 可选：..." 目录; 需要时请整行启用并给真实路径)

# =============================================================================
# 运行机器学习ML配置
# =============================================================================
BOT_MODE=standard                                       # 运行模式: standard=标准模式, adaptive=ML模式

# =============================================================================
# P1 风控与决策日志（2026-10-04 双向交易）
# =============================================================================
DECISION_JOURNAL=true                                    # 决策日志开关（true=记录各层信号+T+4h/24h结果）
RISK_DRAWDOWN_HALT=0.30                                  # 回撤停机阈值（权益相对高水位回撤≥30% 禁止新开仓）
RISK_PER_TRADE_MAX=0.10                                  # 单笔风险上限（止损触发预期亏损≤账户10%，超限自动缩仓）
RISK_RESUME=false                                        # 手动恢复（true 或 1 + 重启 后清除停机状态；停机期间必须保持 false）

# --- 2026-10-08 手续费出血修复新增配置 (4 天 8 往返对账: 毛利 +$0.0005 / 费 -$0.1351) ---
# 2026-11 底部捕获调参 (日志回放: 55k 底部 6 天 0 交易, 55.6k→60.7k 反弹错过):
# 原 0.75 门禁在 "R/R 折扣 + 与历史多数相反折扣" 叠加下数学性不可达 (双 0.85
# 后 92%→66.5%), 已修复折扣逻辑并下调门禁; 平仓门禁 < 开仓门禁 (离场应比
# 开仓容易, 原 0.75 曾拦掉 AI 70% 的止盈 SELL); 每日开仓上限配套控成本。
MIN_CONFIDENCE_OPEN=0.65                                 # BUY 开仓执行层置信度门禁 (0=关闭；默认 0.65)
                                                         # 低于门禁的 BUY 信号不下单（证据: 8 笔开仓全部为 LLM hold 翻转,
                                                         # 最终置信度 51-79%，其中 3 笔恰好 51%）
MIN_CONFIDENCE_CLOSE=0.70                                # 平仓执行层置信度门禁 (0=关闭；默认 0.70)
                                                         # 低于门禁不平仓，仓位由止损/止盈单保护
                                                         # (2026-11-26 P0-2: 0.60→0.70, 65~81% 单次 BUY 2~4 分钟内
                                                         #  反手平掉趋势空单三笔全亏; 趋势仓另受反手保护)
SIGNAL_CONFIRM_CYCLES=1                                  # 同向信号连续周期确认数 (1=关闭；2=连续 2 周期同向才执行)
                                                         # (2026-11-26 P2-10: 单 AI 置信度漂移防护, 建议沙盒验证后设 2)
STARTUP_SYNC_ONLY=true                                   # 重启后首个周期只同步不交易 (false=回滚旧行为)
                                                         # (2026-11-26 P1-4: 部署重启 "首次立即周期" 曾直接造成开仓/2分钟后平仓)
TREND_CLOSE_PROTECTION_MINUTES=60                        # 趋势仓新仓反手保护窗口 (分钟, 0=关闭)
                                                         # (2026-11-26 P0-2: 趋势仓开仓后 N 分钟内, 反向 AI 信号需
TREND_CLOSE_MIN_CONFIDENCE=0.75                          #  置信度≥本值 且 1h 技术趋势已反转 才允许平仓)
                                                         # (2026-11-26 P0-2: 趋势仓反手平仓最低置信度)
DAILY_OPEN_LIMIT=2                                       # 每日最多新开仓笔数 (0=关闭；默认 2)
                                                         # 门禁下调后的成本控制: 限频 + 门禁双保险, 防手续费出血复发
POST_CLOSE_COOLDOWN_MINUTES=30                           # 平仓后冷却分钟数 (0=关闭；默认 30)
                                                         # 平仓后 N 分钟内禁止重新开仓，斩断"平仓后 5 分钟即重开"式 churn
TAKE_PROFIT_RR_MULTIPLE=2.0                              # standard bot 止盈单 R 倍数 (0=不挂止盈单；默认 2.0)

# --- 2026-11 底部捕获: 超卖抄底独立通道 (证据: 11-21 14:14 RSI=16.2 / 24h 最低区,
# 原流水线 5 层折扣后 66.5% < 0.75 门禁被拦, 错过 55.6k→60.7k +9.1% 反弹) ---
OVERSOLD_BUY_ENABLED=true                                # 超卖抄底独立通道开关 (false=关闭；默认 true)
OVERSOLD_BUY_RSI_MAX=20.0                                # 触发 RSI 上限 (≤此值视为极端超卖；默认 20)
OVERSOLD_BUY_NEAR_LOW_PCT=0.01                           # 价格 ≤ 24h低点×(1+此值) 视为贴近底部 (默认 0.01)
OVERSOLD_BUY_CONFIDENCE=0.70                             # 通道固定置信度, 仅审计日志用 (默认 0.70)
OVERSOLD_BUY_POSITION_FACTOR=0.5                         # 抄底仓位系数, 半仓 (默认 0.5)
OVERSOLD_BUY_DAILY_LIMIT=1                               # 每日最多触发次数 (默认 1)
OVERSOLD_BUY_MIN_1H_CHANGE=-0.05                         # 1h 动量守卫 (2026-11-24 回放): 1h 涨跌幅 ≤ 此值时跳过
                                                         # (动量仍在崩塌不接飞刀；回放 11-24 11:03: 1h +0.12% 通过)

# --- 2026-11-24 日志回放: R/R 感知动态开仓门禁 + 高潮做空独立通道 ---
GATE_RELIEF_RR_MIN=2.0                                   # 方向一致 ATR口径 R/R ≥ 此值时放宽开仓门禁 (默认 2.0; 2026-11-24 做多侧改 ATR 口径, 结构 R/R 底部区分母极小会产生几何伪影)
GATE_RELIEF_AMOUNT=0.10                                  # 放宽幅度: 0.65 → 0.55, 放行 55-64% 犹豫带 (默认 0.10)
GATE_RELIEF_FLOOR=0.50                                   # 放宽后门禁下限 (默认 0.50)
CLOSE_RELIEF_AMOUNT=0.10                                 # 2026-11-24 (P0-A): 持仓浮亏 (UPL<0) 时平仓门禁下移幅度 0.60→0.50, 亏损态加速离场 (默认 0.10)
CLOSE_RELIEF_FLOOR=0.40                                  # 亏损态平仓门禁下限 (默认 0.40)
CLIMAX_SHORT_ENABLED=true                                # 高潮做空独立通道开关 (24h 高点区+超买+做空R/R 独立开空)
CLIMAX_SHORT_RR_MIN=2.5                                  # 做空 R/R 下限 (默认 2.5; 回放 11-23 22:00 R/R 3.0-7.1)
CLIMAX_SHORT_RSI_MIN=65.0                                # 1h RSI 超买门槛 (默认 65; 回放 11-23 02:14 RSI≈50 误报被排除)
CLIMAX_SHORT_NEAR_HIGH_PCT=0.02                          # 价格 ≥ 24h高点×(1-此值) 视为高潮区 (默认 0.02)
CLIMAX_SHORT_POSITION_FACTOR=0.5                         # 做空仓位系数, 半仓 (默认 0.5)
CLIMAX_SHORT_DAILY_LIMIT=1                               # 每日最多触发次数 (默认 1)

# ── 趋势跟踪独立通道 (2026-11-25 / 模块 0, 顺势入场) ──
# SMA10/20 1h 趋势方向 + 24h 涨跌幅 ±2% + RSI 排除 → 趋势方向半仓开仓;
# 止损 = 24h 摆动点 ± 0.5×ATR(1h) (上限 2.5%), 10R 安全止盈, 让利润奔跑靠追踪止损
TREND_FOLLOW_ENABLED=true                                # 主开关 (false=一键回滚)
TREND_FOLLOW_CHANGE_PCT=2.0                              # 24h 涨跌幅门槛 %
TREND_FOLLOW_SHORT_RSI_FLOOR=30.0                        # RSI(1h) 低于此值禁空 (防末端追空; 2026-11-26: 20→30)
TREND_FOLLOW_LONG_RSI_CEIL=70.0                          # RSI(1h) 高于此值禁多 (防末端追多; 2026-11-26: 80→70)
TREND_FOLLOW_EXTREME_DISTANCE_PCT=0.005                  # 区间端点禁追: 价在 24h 极值内侧 0.5% 内跳过 (突破极值放行)
TREND_FOLLOW_REQUIRE_HTF_ALIGNMENT=true                  # HTF(4h) 对齐: 高级别趋势与入场方向一致才入场 (数据不足 fail-open)
TREND_FOLLOW_STOP_ATR_BUFFER=0.5                         # 摆动点外扩 0.5×ATR(1h)
TREND_FOLLOW_MAX_STOP_PCT=0.025                          # 止损距离上限 2.5%
TREND_FOLLOW_SAFETY_TP_R=10.0                            # 10R 安全止盈 (正常由追踪止损离场)
TREND_FOLLOW_DAILY_LIMIT=1                               # 每方向每日最多触发次数 (2026-11-26 P0-3: 持久化跨重启)
TREND_FOLLOW_POSITION_FACTOR=0.5                         # 半仓

# ── 追踪止盈 (2026-11-25 / 模块 1, 让利润奔跑) ──
# 浮盈 ≥ 1R → 止损移保本 (entry±0.1%); 浮盈 ≥ 2R → 从极值 3×ATR(1h) 追踪;
# 只收紧不放松; 初始止损价持久化跨重启; 方向错误侧安全钳位 (OKX 51280/51278)
TRAILING_STOP_ENABLED=true                               # 主开关 (false=一键回滚)
TRAILING_BREAKEVEN_AT_R=1.0                              # 浮盈 1R 移保本
TRAILING_ACTIVATE_AT_R=2.0                               # 浮盈 2R 启动 ATR 追踪
TRAILING_ATR_MULT=3.0                                    # 追踪距离 3.0×ATR(1h)
                                                         # TP 距离 = 止损距离 × max(本值, TAKE_PROFIT_MIN_RR_RATIO)
                                                         # 止损 0.5% 时默认 TP=1.0%（2R）；此前 standard 从不下止盈单
